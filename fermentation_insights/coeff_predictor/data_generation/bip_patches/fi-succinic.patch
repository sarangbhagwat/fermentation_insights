diff --git a/biorefineries/succinic/__init__.py b/biorefineries/succinic/__init__.py
index f24723b8..647005a6 100644
--- a/biorefineries/succinic/__init__.py
+++ b/biorefineries/succinic/__init__.py
@@ -18,6 +18,19 @@ This module is a modified implementation of modules from the following:
 # from .import analyses, models
 from warnings import filterwarnings
 filterwarnings('ignore')
+
+# Compatibility: thermosteam.utils.trim_cache (thermosteam <= 0.54.2 at least) iterates
+# over an int (`for i in 20`) and raises TypeError once a chemical-indexer cache exceeds
+# 200 keys, which the succinic systems reach. Replace it at runtime with a working
+# implementation having the intended semantics (drop the 20 oldest cache entries).
+import thermosteam as _tmo
+from itertools import islice as _islice
+def _trim_cache(cache):
+    if cache.__len__() > 200:
+        for key in list(_islice(cache, 20)): del cache[key]
+_tmo.utils.trim_cache = _trim_cache
+if hasattr(_tmo.utils, 'cache'): _tmo.utils.cache.trim_cache = _trim_cache
+
 from biorefineries import succinic
 succinic_filepath = succinic.__file__.replace('\\__init__.py', '')
 succinic_results_filepath = succinic_filepath + '\\analyses\\results\\'
diff --git a/biorefineries/succinic/_process_specification.py b/biorefineries/succinic/_process_specification.py
