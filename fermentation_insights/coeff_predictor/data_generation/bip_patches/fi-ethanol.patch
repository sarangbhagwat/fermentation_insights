From fbd918765f492c6af5b603b3d7e036e67849489e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 22:16:57 +0000
Subject: [PATCH 2/2] corn: mass-conserving yeast growth in the SSF unit

The growth reaction 'Glucose -> Yeast' was defined on a molar basis, so
one glucose (180 g) became one Yeast (22.6 g) and ~87 % of the mass of
the glucose not converted to ethanol disappeared from the broth (cell
mass / sugar fed 0.12 at low ethanol yield). Define it by weight and
express it by mol, as bst.Fermentation does for its cell growth
reaction; the reaction is then thermally neutral (Yeast Hf per kg equals
glucose's).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EDo4jhmi7JA1qzTHaSinXa
---
 biorefineries/corn/units.py | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/biorefineries/corn/units.py b/biorefineries/corn/units.py
index 61efe81f..58a24ded 100644
--- a/biorefineries/corn/units.py
+++ b/biorefineries/corn/units.py
@@ -276,8 +276,10 @@ class SimultaneousSaccharificationFermentation(bst.BatchBioreactor):
     .. math:: 
         Glucose -> 2Ethanol + 2CO_2
     
-    Yeast is assumed to be produced from the any remaining glucose:
-        Glucoes -> Yeast
+    Yeast is assumed to be produced from the any remaining glucose, by mass
+    (1 kg glucose -> 1 kg yeast, as in ``bst.Fermentation``; a molar 1:1
+    stoichiometry would destroy ~87 % of the remaining glucose mass):
+        Glucose -> Yeast
     
     A compound with name 'Yeast' must be present. Note that only glucose is 
     taken into account for conversion. Cleaning and unloading time,
@@ -308,7 +310,10 @@ class SimultaneousSaccharificationFermentation(bst.BatchBioreactor):
             tau=tau, N=N, V_max=V_max, T=T, P=P, Nmin=Nmin, Nmax=Nmax
         )
         self.reaction = tmo.Rxn('Glucose -> 2Ethanol + 2CO2',  'Glucose', yield_)
-        self.growth = tmo.Rxn('Glucose -> Yeast',  'Glucose', 1.0)
+        # Mass-conserving growth: defined by weight, then expressed by mol
+        # (same convention as bst.Fermentation's cell growth reaction).
+        self.growth = tmo.Rxn('Glucose -> Yeast',  'Glucose', 1.0, basis='wt')
+        self.growth.basis = 'mol'
         self.V_wf = V_wf
     
     def _run(self):
-- 
2.43.0

