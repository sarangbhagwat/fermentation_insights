From 3c44f216b69968271371b985acc25b84efa0a7bd Mon Sep 17 00:00:00 2001
From: fi-TAL agent <sarangbhagwat.developer@gmail.com>
Date: Fri, 16 Oct 2026 10:30:35 +0000
Subject: [PATCH 3/4] TAL: restore SystemFactory autorename=None default
 (biosteam 2.54)

Newer biosteam renames units with conflicting IDs by default (e.g., corn's
and TAL's V301 become V301_1/V301_2), which breaks the corn and cornstover
KSA systems that refer to units by ID. Restore the previous default
(newest unit replaces the old one in the registry) in _bst_compat.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EDo4jhmi7JA1qzTHaSinXa
---
 biorefineries/TAL/_bst_compat.py | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/biorefineries/TAL/_bst_compat.py b/biorefineries/TAL/_bst_compat.py
index 3c1d245d..88706dc2 100644
--- a/biorefineries/TAL/_bst_compat.py
+++ b/biorefineries/TAL/_bst_compat.py
@@ -72,3 +72,21 @@ def patch_corn_units():
     from biorefineries import corn
     SSF = corn.units.SimultaneousSaccharificationFermentation
     if SSF._N_ins == 1: SSF._N_ins = 2
+
+# %% SystemFactory autorename
+# Newer biosteam's SystemFactory.__call__ defaults to `autorename=True`, which
+# renames units with conflicting IDs (e.g., corn's V301 and TAL's V301 become
+# V301_1 and V301_2), breaking TAL code and parameter load statements that refer
+# to units by ID. TAL was written for the previous default (`autorename=None`:
+# the newest unit replaces the old one in the flowsheet registry); restore it.
+import inspect as _inspect
+try:
+    _autorename_default = _inspect.signature(bst.SystemFactory.__call__).parameters['autorename'].default
+except Exception:
+    _autorename_default = None
+if _autorename_default is True and not getattr(bst.SystemFactory.__call__, '_TAL_compat', False):
+    _SystemFactory_call = bst.SystemFactory.__call__
+    def _SystemFactory_call_compat(self, *args, autorename=None, **kwargs):
+        return _SystemFactory_call(self, *args, autorename=autorename, **kwargs)
+    _SystemFactory_call_compat._TAL_compat = True
+    bst.SystemFactory.__call__ = _SystemFactory_call_compat
-- 
