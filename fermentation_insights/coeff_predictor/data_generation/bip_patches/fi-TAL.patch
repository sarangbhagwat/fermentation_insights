 # Ash = chemical_database('Ash', search_ID='CaO', phase='s', Hf=-151688*_cal2joule,
 #                         HHV=0, LHV=0)
 CaSO4 = chemical_database('CaSO4')
+# CaSO4 has no liquid molar volume model. Newer thermosteam versions may keep
+# explicit zero-flow entries in (sparse) stream flow vectors, so mixture volumes
+# can evaluate it even when no CaSO4 is present; use its solid molar volume.
+if not CaSO4.V.l: CaSO4.V.l.add_method(CaSO4.V.s(298.15, 101325.))
 # This is to copy the solid state of Xylose,
 # cannot directly use Xylose as Xylose is locked at liquid state now
