@@ -0,0 +1,62 @@
+# -*- coding: utf-8 -*-
+# Bioindustrial-Park: BioSTEAM's Premier Biorefinery Models and Results
+# Copyright (C) 2021-, Sarang Bhagwat <sarangb2@illinois.edu>
+#
+# This module is under the UIUC open-source license. See
+# github.com/BioSTEAMDevelopmentGroup/biosteam/blob/master/LICENSE.txt
+# for license details.
+"""
+Compatibility shims that let the TAL biorefineries (written for
+biosteam ~2.42 / thermosteam 0.42) run on newer BioSTEAM releases
+(tested with biosteam 2.54 / thermosteam 0.54) without changing any process
+assumptions. Each shim is a no-op on the BioSTEAM versions the TAL module was
+originally written for.
+"""
+import biosteam as bst
+
+__all__ = ()
+
+# %% FireWaterTank
+# Newer biosteam's FireWaterTank dropped its stream inlet (_N_ins = 0) and sizes
+# from a fixed `fire_water_flow_rate` attribute. biorefineries.cellulosic's
+# create_facilities (used by every TAL system) still constructs it as
+# `FireWaterTank('FT', fire_water)` and attaches a specification that scales
+# that inlet with the feedstock flow (0.08 kg/kg). Restore the original
+# 1-inlet, inlet-sized behavior (as done for biorefineries.isobutanol).
+
+if getattr(bst.FireWaterTank, '_N_ins', 1) == 0 \
+        and not getattr(bst.FireWaterTank, '_TAL_compat', False):
+    class _FireWaterTank_compat(bst.FireWaterTank):
+        _TAL_compat = True
+        ticket_name = 'FWT'
+        _N_ins = 1
+        _N_outs = 0
+        def _run(self): pass # stored fire water; no stream transformation
+        def _design(self):
+            self.design_results['Flow rate'] = self.ins[0].F_mass
+    _FireWaterTank_compat.__name__ = 'FireWaterTank'
+    bst.FireWaterTank = bst.facilities.FireWaterTank = _FireWaterTank_compat
+
+# %% Pump inlet/outlet flow linking
+# In the BioSTEAM versions TAL was written for, `Pump` was decorated with
+# `static_flow_and_phase`, which linked the material flow rates (and phase) of
+# its inlet and outlet (but not T and P). TAL relies on this to propagate flow
+# rates set by downstream units back to the priced fresh-feed streams (e.g., the
+# CSL and DAP loadings set by the fermenter R302 through CSL_fresh -> T601 ->
+# T601_P -> R302); without it, these feeds remain empty and their costs and
+# impacts are silently dropped. Newer biosteam no longer links pump streams, so
+# restore the old (flow and phase only) link.
+
+def _load_pump_flow_and_phase_links(self):
+    s_in = self._ins[0]
+    s_out = self._outs[0]
+    try:
+        if isinstance(s_in._imol, s_out._imol.__class__):
+            s_out._imol = s_in._imol # shares flow rates and phase; T and P remain independent
+    except Exception:
+        pass
+
+if (not getattr(bst.Pump, '_stream_link_options', None) # attribute of older biosteam versions
+    and not bst.Pump._link_streams
+    and bst.Pump._load_stream_links is bst.Unit._load_stream_links):
+    bst.Pump._load_stream_links = _load_pump_flow_and_phase_links
