     bst.Pump._load_stream_links = _load_pump_flow_and_phase_links
+
+# %% Corn SSF inlets
+def patch_corn_units():
+    """
+    Newer biosteam's BatchBioreactor fixes `_N_ins = 1`, but corn's
+    SimultaneousSaccharificationFermentation takes 2 inlets (its _run mixes
+    all inlets); restore its inlet count before corn.create_system is called
+    (as done for biorefineries.isobutanol). No-op on older biosteam versions.
+    """
+    from biorefineries import corn
+    SSF = corn.units.SimultaneousSaccharificationFermentation
+    if SSF._N_ins == 1: SSF._N_ins = 2
