From aa476e647404386be758c82f78598bd427bddec4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 11:14:16 +0000
Subject: [PATCH 5/7] lactic: fix acid-resistant fermenter costing and dilution
 accuracy

- R301 cost adjustment for the acid-resistant strain (316 SS) referenced
  the old 'Agitator' cost item, renamed to 'Fermenter agitator' earlier
  (KeyError whenever neutralization=False)
- titer_at_water (dilution to the target titer) evaluated the titer after
  a single pass of the seed recycle, so the inoculum was stale (e.g., from
  the 1e10 kg/hr bracket evaluation) and the solver under-diluted by up to
  ~2% of the titer; converge the seed loop at each evaluation instead

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EDo4jhmi7JA1qzTHaSinXa
---
 biorefineries/lactic/_processes.py | 10 ++++++++--
 biorefineries/lactic/_units.py     |  4 ++--
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/biorefineries/lactic/_processes.py b/biorefineries/lactic/_processes.py
index 7232c935..e2329b4b 100644
--- a/biorefineries/lactic/_processes.py
+++ b/biorefineries/lactic/_processes.py
@@ -153,7 +153,10 @@ def create_SSCF_conversion_process(feed, flowsheet=None, **extras): # extras is
     # Add dilution water to achieve the lower titer
     def titer_at_water(water):
         water_R301.imass['Water'] = water
-        seed_recycle.run()
+        # Converge (not a single pass of) the seed loop: with one pass the
+        # inoculum is stale (e.g., from the 1e10 kg/hr bracket evaluation) and
+        # the solver under-dilutes by up to ~2% of the titer
+        seed_recycle.converge()
         return R301.effluent_titer-R301.target_titer
 
     # Lower yield to achieve the lower titer
@@ -287,7 +290,10 @@ def create_SHF_conversion_process(feed, cell_mass_split,
     # Add dilution water to achieve the lower titer
     def titer_at_water(water):
         water_R301.imass['Water'] = water
-        seed_recycle.run()
+        # Converge (not a single pass of) the seed loop: with one pass the
+        # inoculum is stale (e.g., from the 1e10 kg/hr bracket evaluation) and
+        # the solver under-dilutes by up to ~2% of the titer
+        seed_recycle.converge()
         return R301.effluent_titer-R301.target_titer
 
     # Lower yield to achieve the lower titer
diff --git a/biorefineries/lactic/_units.py b/biorefineries/lactic/_units.py
index 38664995..4b34331d 100644
--- a/biorefineries/lactic/_units.py
