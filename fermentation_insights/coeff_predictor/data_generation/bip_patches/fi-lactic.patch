From 0a463cc48222acaa0e1013eb71be467e28989a99 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 11:44:12 +0000
Subject: [PATCH 7/7] lactic: evaluate CoFermentation titers at the
 fermentation temperature

CoFermentation (SHF) computed the influent/effluent titers and the batch
maximum sugar concentration with the broth volume at the mixed-feed
temperature (hot evaporator concentrate) and only then set T, so the
reported titer was up to ~2% below lactic acid mass / broth volume at
50 C. Set the broth temperature first, as SaccharificationAndCoFermentation
does (module-default SHF MPSP unchanged: 1.5655 vs 1.5656 USD/kg).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EDo4jhmi7JA1qzTHaSinXa
---
 biorefineries/lactic/_units.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/biorefineries/lactic/_units.py b/biorefineries/lactic/_units.py
index 4b34331d..8b1a586d 100644
--- a/biorefineries/lactic/_units.py
+++ b/biorefineries/lactic/_units.py
@@ -632,6 +632,9 @@ class CoFermentation(Reactor):
 
         effluent.copy_like(mixed_feed)
         effluent.mol = mixed_feed.mol - sidedraw.mol
+        # Titers/sugar concentrations at the fermentation temperature (as in
+        # SaccharificationAndCoFermentation), not at the mixed-feed temperature
+        effluent.T = self.T
         self.influent_titer = titer0 = compute_lactic_titer(effluent)
         sugars = self.sugars
         if feed_freq == 1:
@@ -675,6 +678,7 @@ class CoFermentation(Reactor):
             self.vessel_material= 'Stainless steel 316'
             lime.empty()
 
+        effluent.T = self.T
         self.effluent_titer = titer1 = compute_lactic_titer(effluent)
         self.tau_cofermentation = (titer1-titer0)/self.productivity
 
