From 293edbb718dc0f9802bf83fb5cd93bc9caeda5ed Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 10:43:23 +0000
Subject: [PATCH 3/7] lactic: run fermentation titer specifications in newer
 BioSTEAM

Newer BioSTEAM only runs System specifications on System.simulate, not
when a nested system is converged as part of its parent, so
adjust_R301_water (SSCF seed_recycle) and adjust_ferm_loop (SHF
ferm_loop) were silently skipped: titer targets were never met by
dilution/concentration (and the SHF evaporator kept V=0.76 on a
near-empty stream). Run them as specifications of the unit right before
each loop (H301 / S301), after that unit's own balance.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EDo4jhmi7JA1qzTHaSinXa
---
 biorefineries/lactic/_processes.py | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/biorefineries/lactic/_processes.py b/biorefineries/lactic/_processes.py
index 7abc8dc6..f3238535 100644
--- a/biorefineries/lactic/_processes.py
+++ b/biorefineries/lactic/_processes.py
@@ -162,8 +162,12 @@ def create_SSCF_conversion_process(feed, flowsheet=None, **extras): # extras is
         seed_recycle.run()
         return R301.effluent_titer-R301.target_titer
 
-    @seed_recycle.add_specification
+    # Newer BioSTEAM does not run the specifications of nested systems when the
+    # parent system converges, so run it as a specification of H301 (the unit
+    # right before the seed recycle loop), after H301's own mass/energy balance
+    @H301.add_specification(run=False)
     def adjust_R301_water():
+        H301._run()
         water_R301.empty()
         set_yield(R301.target_yield, R301, R302)
         seed_recycle.run()
@@ -313,8 +317,12 @@ def create_SHF_conversion_process(feed, cell_mass_split,
         # highest from collected papers)
         return sugar_conc-220
 
-    @ferm_loop.add_specification
+    # Newer BioSTEAM does not run the specifications of nested systems when the
+    # parent system converges, so run it as a specification of S301 (the unit
+    # right before the fermentation loop), after S301's own mass balance
+    @S301.add_specification(run=False)
     def adjust_ferm_loop():
+        S301._run()
         water_R301.empty()
         S302.split = 1
         E301.V = 0
-- 
