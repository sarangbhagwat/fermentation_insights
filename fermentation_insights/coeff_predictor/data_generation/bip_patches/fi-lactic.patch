From ee6eaf793ce76079489a8e6bc98e369d577d7866 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 10:29:06 +0000
Subject: [PATCH 2/7] lactic: keep intended fixed-point convergence; make
 acetic acid yield parameter effective

- load_process_settings sets System.default_converge_method, which newer
  BioSTEAM ignores (the default method is now taken from
  System.default_methods); set it there too so the module's intended
  fixed-point convergence ('aitken isn't stable') is used
- models.set_acetic_yield: also update R301._X, from which the
  fermentation specifications (adjust_R301_water / adjust_ferm_loop)
  reset the acetic acid conversion through set_yield; previously the
  sampled acetic acid yield was overwritten during simulation

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EDo4jhmi7JA1qzTHaSinXa
---
 biorefineries/lactic/_process_settings.py | 3 +++
 biorefineries/lactic/models.py            | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/biorefineries/lactic/_process_settings.py b/biorefineries/lactic/_process_settings.py
index a3264e57..0a70be91 100644
--- a/biorefineries/lactic/_process_settings.py
+++ b/biorefineries/lactic/_process_settings.py
@@ -218,6 +218,9 @@ def load_process_settings(CE=541.7): # year 2016
     # These settings are sufficient to get baseline lactic acid price within $0.002/kg
     # of the final stabilized results
     bst.System.default_converge_method = 'fixed-point' # aitken isn't stable
+    # Newer BioSTEAM selects the default method through `default_methods`
+    if hasattr(bst.System, 'default_methods'):
+        bst.System.default_methods['Sequential modular'] = 'fixed-point'
     bst.System.default_maxiter = 1500
     bst.System.default_molar_tolerance = 0.02
 
diff --git a/biorefineries/lactic/models.py b/biorefineries/lactic/models.py
index dcdbf092..9b9991ba 100644
--- a/biorefineries/lactic/models.py
+++ b/biorefineries/lactic/models.py
@@ -394,6 +394,9 @@ def create_model(flowsheet=None, kind='SSCF'):
     @param(name='Acetic acid yield', element=R301, kind='coupled', units='g/g',
            baseline=0.07, distribution=D)
     def set_acetic_yield(acetic_yield):
+        # The fermentation specifications call `set_yield`, which resets the
+        # acetic acid conversion from `R301._X`; update it so the value persists
+        R301._X[1] = R301._X[4] = acetic_yield
         R301_X = R301.cofermentation_rxns.X
         R302_X = R302.cofermentation_rxns.X
         R301_X[1] = R301_X[4] = min(acetic_yield, 1-1e-6-R301_X[0]-R301_X[2])
-- 
