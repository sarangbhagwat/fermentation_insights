From 7481ac8d49efbe8b026d62ffccd953704b77f728 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 11:01:09 +0000
Subject: [PATCH 4/7] lactic: fix SHF sugar-concentration path (now exercised)

With adjust_ferm_loop running again, the SHF concentration branch failed:
- create_SHF_conversion_process used sugars=None in get_max_V/sugar_at_V;
  default to the module's sugars tuple
- R301's update_split specification changes the S302 split but ran R301
  with a stale evaporator-path inlet (S302-1 -> E301 -> E301_T -> E301_P),
  so with allow_concentration R301 received no feed (zero broth volume);
  re-run that path before R301

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EDo4jhmi7JA1qzTHaSinXa
---
 biorefineries/lactic/_processes.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/biorefineries/lactic/_processes.py b/biorefineries/lactic/_processes.py
index f3238535..7232c935 100644
--- a/biorefineries/lactic/_processes.py
+++ b/biorefineries/lactic/_processes.py
@@ -192,6 +192,8 @@ def create_SSCF_conversion_process(feed, flowsheet=None, **extras): # extras is
 def create_SHF_conversion_process(feed, cell_mass_split,
                                   sugars=None, flowsheet=None):
     flowsheet = flowsheet or bst.main_flowsheet
+    # `sugars` is used by the sugar-concentration functions of adjust_ferm_loop
+    if sugars is None: from ._chemicals import sugars
 
     ##### Streams #####
     # flow updated in EnzymeHydrolysateMixer
@@ -263,6 +265,10 @@ def create_SHF_conversion_process(feed, cell_mass_split,
             split = min(1-1e-6, 1/R301.feed_freq)
             S302._isplit = S302.thermo.chemicals.isplit(split)
         S302._run()
+        # Update the evaporator path to R301 (S302-1 -> E301 -> E301_T -> E301_P),
+        # otherwise R301 sees a stale add_feed after the split is changed here
+        # (with concentration, all feed would be missing -> zero broth volume)
+        for i in (E301, E301_T, E301_P): i.run()
         R301._run()
 
     R301_P1 = bst.units.Pump('R301_P1', ins=R301-0)
-- 
