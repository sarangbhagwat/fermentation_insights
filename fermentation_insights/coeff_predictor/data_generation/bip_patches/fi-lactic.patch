From 89329b6455d2d0984b96d1b6da26efa0c74cdbff Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 11:27:30 +0000
Subject: [PATCH 6/7] lactic: converge the SHF fermentation loop in the
 concentration solvers

titer_at_V and sugar_at_V (sugar concentration by E301 to the target
titer / 220 g/L sugar limit) evaluated a single pass of ferm_loop, so the
solvers worked on a stale inoculum and failed to reach feasible targets
(notably for the acid-resistant strain); converge the loop instead, as
in titer_at_water.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EDo4jhmi7JA1qzTHaSinXa
---
 biorefineries/lactic/_processes.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/biorefineries/lactic/_processes.py b/biorefineries/lactic/_processes.py
index e2329b4b..12aaf67b 100644
--- a/biorefineries/lactic/_processes.py
+++ b/biorefineries/lactic/_processes.py
@@ -312,12 +312,12 @@ def create_SHF_conversion_process(feed, cell_mass_split,
     # Adjust V of the multi-effect evaporator to achieve the set sugar concentration
     def titer_at_V(V):
         E301.V = V
-        ferm_loop.run()
+        ferm_loop.converge() # not a single pass (stale inoculum), see titer_at_water
         return R301.effluent_titer-R301.target_titer
 
     def sugar_at_V(V):
         E301.V = V
-        ferm_loop.run()
+        ferm_loop.converge() # not a single pass (stale inoculum), see titer_at_water
         # In continuous mode, incoming sugar is immediately consumed, therefore
         # sugar concentration is always held at the same level (as effluent sugar
         # concentration in batch mode)
